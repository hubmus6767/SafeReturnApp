<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Dodaj Nowy Punkt Terenowy"
        android:textColor="@color/text_main"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- aktuana pozycja z GPS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@color/card_bg"
        android:elevation="1dp"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="POBRANE WSPÓŁRZĘDNE GPS"
            android:textColor="@color/forest_accent"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Szerokość: 49.621435 N\nDługość: 20.704210 E"
            android:textColor="@color/text_main"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- formularz -->
    <EditText
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="12dp"
        android:background="@color/card_bg"
        android:hint=" Nazwa punktu (np. Źródełko w lesie)"
        android:paddingHorizontal="12dp"
        android:textSize="13sp" />

    <EditText
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_marginBottom="16dp"
        android:background="@color/card_bg"
        android:gravity="top|start"
        android:hint=" Opis / Notatka terenowa (opcjonalnie)"
        android:padding="12dp"
        android:textSize="13sp" />

    <!-- przelacznik do ustwwienia punktu na prywatny lub publiczny  -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:background="@color/card_bg"
        android:elevation="1dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Zabezpiecz Sejfem Biometrycznym"
                android:textColor="@color/text_main"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wymagaj odcisku palca przy odczycie"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <Switch
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="48dp"
            android:minHeight="48dp"/>
    </LinearLayout>

    <!-- przycisk zapisu w bazie -->
    <Button
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:backgroundTint="@color/forest_primary"
        android:text="ZAPISZ W CHMURZE FIREBASE"
        android:textColor="@android:color/white"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>